[gd_scene load_steps=5 format=3 uid="uid://b5l1wxu872i2p"]

[ext_resource type="Script" uid="uid://cp2l1n8xoa6t1" path="res://Testing/OptionButton.gd" id="1_wurot"]
[ext_resource type="Theme" uid="uid://chxsbitmb5lsf" path="res://Themes/generated/dark_theme.tres" id="1_xnew6"]

[sub_resource type="GDScript" id="GDScript_wurot"]
script/source = "extends Control

@onready var fc : FlowController = %FlowController

func _ready() -> void:
	fc.load_event(YAML.load_file(\"res://export.yml\").get_data())
	fc.next(0)

func _on_button_pressed() -> void:
	await fc.next(0)
"

[sub_resource type="GDScript" id="GDScript_wwfsh"]
script/source = "extends FlowController

@onready var author = %Author
@onready var dialogue = %Dialogue

func next(port) -> void:
	go_from_port(port)
	match current_node.type:
		\"Talk\":
			author.text = event.vars.get(\"authors\", {}).get(\"values\", {})[current_node.data.get(\"Author\", 0)]
			dialogue.text = current_node.data.get(\"Dialogue\", \"\")
			
			%GoNextNormal.visible = true
			%OptionButtons.visible = false
		\"Start\":
			pass
		\"Choice2\":
			author.text = \"Choice\"
			dialogue.text = \"Make a choice!!\"
			
			%Option1.text = current_node.data.get(\"Option1\", \"missing option 1\")
			%Option2.text = current_node.data.get(\"Option2\", \"missing option 2\")

			%GoNextNormal.visible = false
			%OptionButtons.visible = true
		\"Tunnel Entrance\":
			var tunnel_name = current_node.data.get(\"TunnelName\", \"\")
			for node : FlowNode in event.nodes:
				if node.type == &\"Tunnel Exit\" and node.data.get(\"TunnelName\", \"\") == tunnel_name:
					current_node = node
					next(0)
					return
"

[node name="TestScene" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_xnew6")
script = SubResource("GDScript_wurot")

[node name="FlowController" type="Node" parent="."]
